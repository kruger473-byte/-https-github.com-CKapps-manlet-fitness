{
  "name": "manlet-fitness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "e2e": "node scripts/e2e.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "jose": "6.2.9",
    "next": "15.5.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "playwright-core": "1.58.2",
    "postcss": "8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
