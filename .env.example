# ---------------------------------------------------------------------------
# Manlet Fitness — environment
#
# The app boots and is fully explorable with ONLY DATABASE_URL set. Every
# integration below is optional; unconfigured ones are skipped rather than
# throwing, and billing falls back to a clearly-labelled demo mode.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# Production (Postgres): change `provider` in prisma/schema.prisma to
# "postgresql" and set e.g.
# DATABASE_URL="postgresql://user:password@host:5432/manlet"

# Public base URL — used for Stripe redirects, tracked links and OAuth callbacks
APP_URL="http://localhost:3000"

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be set to a real secret in production.
SESSION_SECRET=""

# Payments -------------------------------------------------------------------
# Without these, checkout runs in demo mode (subscriptions activate locally).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Local webhook testing:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook

# Meta / Instagram -----------------------------------------------------------
# Pixel + token enable the Conversions API (server-side conversions).
META_PIXEL_ID=""
META_CONVERSIONS_TOKEN=""
# App id + secret enable connecting an Instagram account for content stats.
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"

# TikTok ---------------------------------------------------------------------
TIKTOK_PIXEL_CODE=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Google ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Resource name, e.g. customers/1234567890/conversionActions/987654321
GOOGLE_ADS_CONVERSION_ACTION=""

# Video hosting --------------------------------------------------------------
# "local" plays the sourceUrl directly. Use "mux" or "cloudflare" in production
# so paid videos are served behind short-lived signed URLs.
VIDEO_PROVIDER="local"
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_KEY_SECRET=""
